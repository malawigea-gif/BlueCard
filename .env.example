# PostgreSQL database (free Supabase project → Connect → ORMs / Connection string)
# DATABASE_URL: "Transaction pooler" connection (port 6543) — used by the website
DATABASE_URL="postgresql://postgres.xxxxxxxx:YOUR-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"
# DIRECT_URL: "Session pooler" / direct connection (port 5432) — used by "npm run db:push"
DIRECT_URL="postgresql://postgres.xxxxxxxx:YOUR-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
# File storage for uploads (Supabase → Project Settings → API). Leave empty to keep files in the local ./uploads folder.
SUPABASE_URL="https://xxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="uploads"
# Long random secret used to sign session tokens (at least 32 characters)
AUTH_SECRET="change-this-to-a-long-random-secret-string-123456"
# First Admin account (created by the seed script)
ADMIN_EMAIL="admin@bluecard.lk"
ADMIN_PASSWORD="Admin@123"

# Public address of the website (used for PayHere return / notify links), without a trailing slash
SITE_URL="http://localhost:3000"
# PayHere payment gateway — PayHere → Settings → Domains & Credentials (merchant secret is per domain)
PAYHERE_MERCHANT_ID=""
PAYHERE_MERCHANT_SECRET=""
# "true" = sandbox (test payments), "false" = live payments
PAYHERE_SANDBOX="true"
# Optional: PayHere → Settings → API Keys. Lets the site confirm a payment itself when PayHere's
# notification cannot reach it (e.g. while testing on localhost).
PAYHERE_APP_ID=""
PAYHERE_APP_SECRET=""
